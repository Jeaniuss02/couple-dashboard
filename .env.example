# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Safe to expose — the anon key is governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only. Used by Route Handlers for notification fan-out and phone
# verification (both need tables RLS hides from everyone else).
# NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Phone verification
# ---------------------------------------------------------------------------
# Pepper for the HMAC over OTP codes. A 6-digit code is only a million
# possibilities, so a plain hash would fall to an offline sweep if the database
# leaked; this keeps the secret outside the database entirely.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional — falls back to SUPABASE_SERVICE_ROLE_KEY, which is equally strong.
# Changing it invalidates any codes already in flight (harmless; they re-send).
PHONE_VERIFICATION_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp — pick ONE provider
# ---------------------------------------------------------------------------
# 'twilio' | 'meta' | 'webhook' | 'console'  ('console' just logs, for local dev)
WHATSAPP_PROVIDER=console

# --- Twilio WhatsApp API ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# Sandbox number is whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional: approved content template SID for out-of-session messages
TWILIO_CONTENT_SID=

# --- Meta WhatsApp Business Cloud API ---
META_WABA_PHONE_NUMBER_ID=
META_WABA_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
# Approved template name used when the 24h customer-service window is closed
META_FALLBACK_TEMPLATE=couple_board_update
META_TEMPLATE_LANG=en

# --- Generic HTTP webhook (e.g. a self-hosted bridge) ---
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kuala_Lumpur
